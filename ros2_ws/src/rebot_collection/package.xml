<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"?>
<package format="3">
  <name>rebot_collection</name>
  <version>0.1.0</version>
  <description>ROS 2 teleoperation and rosbag collection pipeline for reBotArm B601-RS.</description>
  <maintainer email="sunxiaoyusisu-tech@users.noreply.github.com">sunxiaoyusisu-tech</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rebotarm_bringup</exec_depend>
  <exec_depend>rebotarmcontroller</exec_depend>
  <exec_depend>rosbag2</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <exec_depend>rqt_gui</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>usb_cam</exec_depend>
  <exec_depend>rqt_image_view</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-numpy</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
