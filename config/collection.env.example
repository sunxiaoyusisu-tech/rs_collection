# Copy the values you need into your shell profile or source this file after
# adapting it. Do not commit machine-specific secrets or device credentials.

export REBOT_OFFICIAL_WS="$HOME/rebotarm_ros2"
export REBOT_COLLECTION_WS="$HOME/rs_collection/ros2_ws"
export REBOT_LEROBOT_PYTHON="$HOME/miniforge3/envs/lerobot/bin/python"
export REBOT_LEROBOT_ROOT="$HOME/rebot_lerobot"
export REBOT_BAG_ROOT="$HOME/sun_ws/data"

export REBOT_LEADER_PORT="/dev/ttyUSB0"
export REBOT_HEAD_CAMERA_DEVICE="/dev/v4l/by-id/usb-icSpring_icspring_camera_20240307110322-video-index0"
export REBOT_CAMERA_WRIST_DEVICE="/dev/v4l/by-id/usb-RYS_USB_Camera_200901010001-video-index0"

# 200 means roughly 20 ms for these UVC devices and keeps exposure under the
# 33 ms frame period required for 30 Hz capture.
export REBOT_HEAD_CAMERA_EXPOSURE="200"
export REBOT_WRIST_CAMERA_EXPOSURE="200"
