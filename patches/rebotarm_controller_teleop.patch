+        target: float,
+        *,
+        kp: float,
+        kd: float,
+        moving_limit: float,
+        hold_limit: float,
+    ) -> float:
+        now = time.perf_counter()
+        if self._teleop_gripper_prev_time is None:
+            dt = 0.02
+        else:
