diff --git a/src/rebotarmcontroller/rebotarmcontroller/teleop_stream.py b/src/rebotarmcontroller/rebotarmcontroller/teleop_stream.py
new file mode 100644
index 0000000..567e9ad
--- /dev/null
+++ b/src/rebotarmcontroller/rebotarmcontroller/teleop_stream.py
@@ -0,0 +1,213 @@
+from __future__ import annotations
+
+import math
+import time
+
+import numpy as np
+from diagnostic_msgs.msg import DiagnosticArray, DiagnosticStatus, KeyValue
+from rclpy.qos import HistoryPolicy, QoSProfile, ReliabilityPolicy
+from sensor_msgs.msg import JointState
+
+
+_EXPECTED_NAMES = ["joint1", "joint2", "joint3", "joint4", "joint5", "joint6", "gripper"]
+_LIMITS_DEG = [
+    (-145.0, 145.0),
+    (0.0, 170.0),
+    (0.0, 200.0),
+    (-80.0, 90.0),
+    (-90.0, 90.0),
+    (-130.0, 130.0),
+    (0.0, 270.0),
+]
+_LIMITS_RAD = [(math.radians(lo), math.radians(hi)) for lo, hi in _LIMITS_DEG]
+
+
+def _diagnostic_level_as_byte(level: int | bytes | bytearray) -> bytes:
+    """Normalize diagnostic_msgs/DiagnosticStatus.level to ROS `byte`."""
+    if isinstance(level, (bytes, bytearray)):
+        if len(level) != 1:
+            raise ValueError(f"diagnostic level must contain one byte, got {level!r}")
+        return bytes(level)
+    value = int(level)
+    if not 0 <= value <= 255:
+        raise ValueError(f"diagnostic level must be in [0, 255], got {value}")
+    return bytes([value])
+
+
+class WholeArmTeleopStream:
+    """Validated, watchdog-protected whole-arm command subscriber."""
+
+    def __init__(
+        self,
+        node,
+        hardware,
+        topic: str,
+        *,
+        watchdog_s: float,
+        max_command_age_s: float,
+        resume_max_delta_rad: float,
+        gripper_resume_max_delta_rad: float,
+    ) -> None:
+        self._node = node
+        self._hardware = hardware
+        self._watchdog_s = max(0.02, float(watchdog_s))
+        self._max_command_age_s = max(0.02, float(max_command_age_s))
+        self._resume_max_delta = max(0.0, float(resume_max_delta_rad))
+        self._gripper_resume_max_delta = max(
+            0.0, float(gripper_resume_max_delta_rad)
+        )
+        self._last_valid_monotonic: float | None = None
+        self._timed_out = False
+        self._accepted = 0
+        self._rejected = 0
+
+        qos = QoSProfile(
+            history=HistoryPolicy.KEEP_LAST,
+            depth=1,
+            reliability=ReliabilityPolicy.RELIABLE,
+        )
+        self._subscription = node.create_subscription(
+            JointState,
+            topic,
+            self._on_action,
+            qos,
+            callback_group=node.reentrant_group,
+        )
+        self._applied_publisher = node.create_publisher(
+            JointState,
+            "/teleop/applied",
+            qos,
+            callback_group=node.reentrant_group,
+        )
+        self._diagnostics = node.create_publisher(
+            DiagnosticArray,
+            "/diagnostics",
+            QoSProfile(depth=10, reliability=ReliabilityPolicy.RELIABLE),
+            callback_group=node.reentrant_group,
+        )
+        self._timer = node.create_timer(
+            min(0.02, self._watchdog_s / 2.0),
+            self._check_watchdog,
+            callback_group=node.reentrant_group,
+        )
+        self._publish_diagnostic(
+            DiagnosticStatus.WARN,
+            "waiting for the first /teleop/action sample",
+        )
+        node.get_logger().info(
+            f"whole-arm teleop stream enabled on {topic}; watchdog={self._watchdog_s:.3f}s"
+        )
+
+    def _on_action(self, msg: JointState) -> None:
+        try:
+            values = self._validate_and_order(msg)
+            if self._timed_out or self._last_valid_monotonic is None:
+                self._validate_resume_delta(values)
+            self._hardware.send_teleop_targets(
+                values[:6],
+                values[6],
+                gripper_kp=12.0,
+                gripper_kd=0.05,
+                gripper_motor_kd=0.5,
+                gripper_moving_torque_limit=3.5,
+                gripper_hold_torque_limit=1.0,
+            )
+            # This is an execution acknowledgement, not merely another copy of
+            # the desired input topic: it is published only after the grouped
+            # arm and gripper writes above return successfully.
+            self._applied_publisher.publish(msg)
+        except Exception as exc:
+            self._rejected += 1
+            self._node.get_logger().warn(f"rejected teleop action: {exc}")
+            self._publish_diagnostic(DiagnosticStatus.ERROR, str(exc))
+            return
+
+        resumed = self._timed_out
+        self._last_valid_monotonic = time.monotonic()
+        self._timed_out = False
+        self._accepted += 1
+        if resumed or self._accepted == 1:
+            self._publish_diagnostic(DiagnosticStatus.OK, "teleop action stream active")
+            self._node.publish_arm_status(read_hardware=False)
+
+    def _validate_and_order(self, msg: JointState) -> np.ndarray:
+        if len(msg.name) != len(_EXPECTED_NAMES) or len(msg.position) != len(_EXPECTED_NAMES):
+            raise ValueError("action must contain exactly joint1..joint6 and gripper")
+        if len(set(msg.name)) != len(msg.name) or set(msg.name) != set(_EXPECTED_NAMES):
+            raise ValueError("action joint names are missing, duplicated, or unknown")
+        stamp_ns = int(msg.header.stamp.sec) * 1_000_000_000 + int(msg.header.stamp.nanosec)
+        if stamp_ns <= 0:
+            raise ValueError("action header stamp is zero")
+        now_ns = int(self._node.get_clock().now().nanoseconds)
+        age_s = (now_ns - stamp_ns) / 1_000_000_000.0
+        if age_s > self._max_command_age_s or age_s < -0.05:
+            raise ValueError(f"action timestamp age {age_s:.3f}s is outside the safety window")
+
+        by_name = dict(zip(msg.name, msg.position, strict=True))
+        values = np.asarray([by_name[name] for name in _EXPECTED_NAMES], dtype=np.float64)
+        if not np.all(np.isfinite(values)):
+            raise ValueError("action contains NaN or infinity")
+        for name, value, (lower, upper) in zip(
+            _EXPECTED_NAMES, values, _LIMITS_RAD, strict=True
+        ):
+            if value < lower - 1e-6 or value > upper + 1e-6:
+                raise ValueError(
+                    f"{name}={value:.4f}rad exceeds [{lower:.4f}, {upper:.4f}]"
+                )
+        return values
+
+    def _validate_resume_delta(self, values: np.ndarray) -> None:
+        if self._resume_max_delta <= 0.0:
+            return
+        current = np.asarray(
+            self._hardware.get_joint_positions(request=True), dtype=np.float64
+        )
+        max_delta = float(np.max(np.abs(values[:6] - current)))
+        if max_delta > self._resume_max_delta:
+            raise ValueError(
+                f"resume alignment required: arm delta {max_delta:.3f}rad exceeds "
+                f"{self._resume_max_delta:.3f}rad"
+            )
+        if self._hardware.has_gripper and self._gripper_resume_max_delta > 0.0:
+            current_gripper = float(self._hardware.get_gripper_state()[0])
+            gripper_delta = abs(float(values[6]) - current_gripper)
+            if gripper_delta > self._gripper_resume_max_delta:
+                raise ValueError(
+                    f"resume alignment required: gripper delta {gripper_delta:.3f}rad exceeds "
+                    f"{self._gripper_resume_max_delta:.3f}rad"
+                )
+
+    def _check_watchdog(self) -> None:
+        if self._last_valid_monotonic is None or self._timed_out:
+            return
+        elapsed = time.monotonic() - self._last_valid_monotonic
+        if elapsed <= self._watchdog_s:
+            return
+        try:
+            self._hardware.hold_teleop_position(gripper_motor_kd=0.5)
+        except Exception as exc:
+            self._node.get_logger().error(f"teleop watchdog hold failed: {exc}")
+            self._publish_diagnostic(DiagnosticStatus.ERROR, f"watchdog hold failed: {exc}")
+        else:
+            self._publish_diagnostic(
+                DiagnosticStatus.WARN,
+                f"teleop input stale for {elapsed:.3f}s; holding current pose",
+            )
+        self._timed_out = True
+        self._node.publish_arm_status(read_hardware=False)
+
+    def _publish_diagnostic(self, level: int | bytes, message: str) -> None:
+        item = DiagnosticStatus()
+        item.level = _diagnostic_level_as_byte(level)
+        item.name = "rebot_collection/teleop_action"
+        item.hardware_id = "reBotArm-B601-RS"
+        item.message = message
+        item.values = [
+            KeyValue(key="accepted_samples", value=str(self._accepted)),
+            KeyValue(key="rejected_samples", value=str(self._rejected)),
+            KeyValue(key="watchdog_seconds", value=f"{self._watchdog_s:.3f}"),
+        ]
+        array = DiagnosticArray()
+        array.header.stamp = self._node.get_clock().now().to_msg()
+        array.status = [item]
+        self._diagnostics.publish(array)
